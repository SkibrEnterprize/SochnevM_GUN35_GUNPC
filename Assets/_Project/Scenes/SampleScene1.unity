    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _objectName
      value: "\u0418\u0432\u0430\u043D"
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Short
      value: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u043E\u043C\u043E\u0449\u044C
        \u0440\u0430\u0441\u0447\u0451\u0442\u0430\u0445 \u0443 \u0421\u044D\u043C\u0430"
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Answer
      value: "\u041A\u0430\u043A\u043E\u0439 \u0435\u0449\u0451 \u0430\u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u0446\u0438\u0435\u0439?
        \u041A\u0442\u043E \u0435\u043C\u0443 \u044D\u0442\u043E \u043F\u043E\u0440\u0443\u0447\u0438\u043B?!
        \u041E\u0445, \u043F\u043E\u043C\u043E\u0433\u0443 \u043F\u043E\u0441\u043B\u0435
        \u043E\u0431\u0435\u0434\u0430..."
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Target
      value: 
      objectReference: {fileID: 1056483392}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Question
      value: "\u042D\u0439, \u0431\u0440\u043E! \u0421\u043A\u0430\u0436\u0438 \u0421\u044D\u043C\u0443,
        \u0447\u0442\u043E \u0443 \u043C\u0435\u043D\u044F \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430
        \u0441 \u0430\u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u0446\u0438\u0435\u0439
        \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438 \u0434\u0432\u0438\u0436...
        \u041D\u0435 \u0432\u0430\u0436\u043D\u043E, \u043F\u0440\u043E\u0441\u0442\u043E
        \u043F\u043E\u043F\u0440\u043E\u0441\u0438 \u0435\u0433\u043E \u043F\u043E\u043C\u043E\u0447\u044C,
        \u043A\u0430\u043A \u0431\u0443\u0434\u0435\u0442 \u0432\u0440\u0435\u043C\u044F!"
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].FullDescription
      value: "\u041F\u0440\u0438\u0432\u0435\u0442"
      objectReference: {fileID: 0}
