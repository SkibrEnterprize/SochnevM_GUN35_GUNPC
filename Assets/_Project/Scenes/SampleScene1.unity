      value: Sam_Bot
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _objectName
      value: "\u0421\u044D\u043C"
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Short
      value: "\u0422\u043E\u043B\u044F \u0438 \u041A\u043E\u043B\u044F \u0441\u043D\u043E\u0432\u0430
        \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442 \u0434\u0435\u0434\u043B\u0430\u0439\u043D"
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[1].Short
      value: "\u0421\u044D\u043C, \u044F \u0438 \u0414\u0435\u043D\u0438\u0441 \u0441\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C
        \u043D\u0430 \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0445 \u0432 \u0431\u0430\u0440"
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Answer
      value: "\u0414\u0430 \u0451\u043C\u0430\u0435! \u0421\u044D\u043C \u0441\u0438\u043B\u044C\u043D\u043E
        \u0440\u0432\u0435\u0442 \u0438 \u043C\u0435\u0447\u0435\u0442? \u0429\u0430\u0441
        \u043F\u043E\u0439\u0434\u0435\u043C \u0434\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044C\u0441\u044F..."
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Target
      value: 
      objectReference: {fileID: 1285516846}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[1].Answer
      value: "\u041E\u043F\u044F\u0442\u044C? \u0412\u043E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
        \u0435\u043B\u0435 \u0434\u043E \u0434\u043E\u043C\u0430 \u0434\u043E\u0431\u0438\u0440\u0430\u043B\u0438\u0441\u044C...
        \u041D\u0435-\u043D\u0435-\u043D\u0435, \u044F \u043D\u0435 \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0441\u044C
        - \u044F \u0431\u0443\u0434\u0443 \u043A\u0430\u043A \u0448\u0442\u044B\u043A!"
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[1].Target
      value: 
      objectReference: {fileID: 1847150573}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Question
      value: "\u0422\u0430\u043A, \u0442\u0435\u0431\u0435 \u0441\u0435\u0439\u0447\u0430\u0441
        \u0441\u043F\u0435\u0446\u0437\u0430\u0434\u0430\u043D\u0438\u0435 - \u043F\u0443\u043B\u0435\u0439
        \u0432 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0439 \u043E\u0444\u0438\u0441
        \u0438 \u0441\u043A\u0430\u0436\u0438 \u0422\u043E\u043B\u0435, \u0447\u0442\u043E\u0431\u044B
        \u043E\u043D \u0441 \u0431\u0440\u0430\u0442\u043E\u043C \u0412\u041D\u0415\u0417\u0410\u041F\u041D\u041E
        \u0441\u0434\u0430\u043B \u0437\u0430\u0434\u0430\u0447\u0443 \u043D\u0430
        \u0440\u0435\u0432\u044C\u044E!"
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[1].Question
      value: "\u0422\u0430\u043A, \u0441\u0442\u043E\u044F\u0442\u044C! \u0427\u043E
        \u0442\u044B \u043A\u0430\u043A \u0443\u0433\u043E\u0440\u0435\u043B\u044B\u0439
        \u043F\u043E \u043E\u0444\u0438\u0441\u0430\u043C \u043C\u043E\u0442\u0430\u0435\u0448\u044C\u0441\u044F?!
        \u0417\u0430\u0439\u043C\u0438\u0441\u044C \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u043C
        \u0434\u0435\u043B\u043E\u043C \u0438 \u0441\u043A\u0430\u0436\u0438 \u0414\u044D\u043D\u0443,
        \u0447\u0442\u043E \u0432 \u0441\u0443\u0431\u0431\u043E\u0442\u0443 \u0432
        \u043F\u044F\u0442\u044C \u0447\u0430\u0441\u043E\u0432 \u0432 \u0431\u0430\u0440\u0435"
      objectReference: {fileID: 0}
