    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Short
      value: "\u041F\u0435\u043A\u0443 \u043E\u043F\u044F\u0442\u044C \u0434\u043E\u0441\u0442\u0430\u044E\u0442
        \u043C\u043E\u043B\u043E\u0434\u044B\u0435"
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Answer
      value: "\u041D\u0443 \u0437\u0434\u043E\u0440\u043E\u0432\u0430, \u0449\u0430
        \u0447\u0438\u043F\u0441\u043E\u043D\u044B \u0434\u043E\u0435\u043C \u0438
        \u043F\u043E\u0439\u0434\u0443 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u044E,
        \u043A\u0430\u043A \u0442\u0430\u043C \"\u044F \u043D\u0438\u0447\u0435\u0433\u043E
        \u043D\u0435 \u0434\u0435\u043B\u0430\u043B, \u043E\u043D\u043E \u0441\u0430\u043C\u043E\""
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Target
      value: 
      objectReference: {fileID: 1285276285}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Question
      value: "\u0410\u0439! \u041E\u0439! \u0422\u044B \u0436\u0435 \u0437\u0434\u0435\u0441\u044C
        \u0432\u0441\u0435\u0445 \u0437\u043D\u0430\u0435\u0448\u044C, \u0434\u0430?
        \u041C\u044B \u0441 \u041A\u043E\u043B\u0435\u0439 \u043D\u0435 \u043C\u043E\u0436\u0435\u043C
        \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0441\u0431\u043E\u0440\u043A\u0443
        \u043D\u0430 \u0432\u0438\u0440\u0442\u0443\u0430\u043B\u043A\u0435, \u0441\u043A\u0430\u0437\u0430\u043B\u0438
        \u0435\u0441\u043B\u0438 \u0447\u0442\u043E \u043A \u041F\u0435\u043A\u0435
        \u043E\u0431\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F, \u044D\u0442\u043E
        \u043A\u0442\u043E?"
      objectReference: {fileID: 0}
