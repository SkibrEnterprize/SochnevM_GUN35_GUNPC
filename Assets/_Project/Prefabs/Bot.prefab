  _interactRadius: 2
  _objectName: "\u0418\u0432\u0430\u043D"
  _circle: {fileID: 711552802262635641}
  _quests:
  - State: 0
    Target: {fileID: 0}
    Short: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u043E\u043C\u043E\u0449\u044C
      \u0440\u0430\u0441\u0447\u0451\u0442\u0430\u0445 \u0443 \u0421\u044D\u043C\u0430"
    Question: "\u042D\u0439, \u0431\u0440\u043E! \u0421\u043A\u0430\u0436\u0438 \u0421\u044D\u043C\u0443,
      \u0447\u0442\u043E \u0443 \u043C\u0435\u043D\u044F \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430
      \u0441 \u0430\u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u0446\u0438\u0435\u0439
      \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438 \u0434\u0432\u0438\u0436...
      \u041D\u0435 \u0432\u0430\u0436\u043D\u043E, \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u043E\u043F\u0440\u043E\u0441\u0438 \u0435\u0433\u043E \u043F\u043E\u043C\u043E\u0447\u044C,
      \u043A\u0430\u043A \u0431\u0443\u0434\u0435\u0442 \u0432\u0440\u0435\u043C\u044F!"
    Answer: "\u041A\u0430\u043A\u043E\u0439 \u0435\u0449\u0451 \u0430\u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u0446\u0438\u0435\u0439?
      \u041A\u0442\u043E \u0435\u043C\u0443 \u044D\u0442\u043E \u043F\u043E\u0440\u0443\u0447\u0438\u043B?!
      \u041E\u0445, \u043F\u043E\u043C\u043E\u0433\u0443 \u043F\u043E\u0441\u043B\u0435
      \u043E\u0431\u0435\u0434\u0430..."
